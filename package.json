{
	"name": "pdf-annotator",
	"version": "0.3.0",
	"description": "Annotate PDFs with drawing, highlights, shapes, text, and images. Store annotations in readable Markdown without modifying the PDF.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"test": "node --test tests/*.test.mjs",
		"test:browser": "node scripts/check-text-layer-browser.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"check:release": "node scripts/check-release.mjs",
		"check": "npm run check:release && npm test && npm run build",
		"release:prepare": "npm run check && node scripts/prepare-release.mjs",
		"version": "node scripts/version-bump.mjs"
	},
	"keywords": ["obsidian", "obsidian-plugin", "pdf", "annotations"],
	"author": "Joshua",
	"license": "MIT",
	"engines": {
		"node": ">=22"
	},
	"devDependencies": {
		"@types/node": "^20.11.0",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.21.0",
		"obsidian": "latest",
		"pdfjs-dist": "^4.2.67",
		"tslib": "^2.6.2",
		"typescript": "^5.4.0"
	},
	"dependencies": {
		"pdf-lib": "^1.17.1"
	}
}
